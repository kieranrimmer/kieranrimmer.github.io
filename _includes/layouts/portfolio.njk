---
layout: layouts/base.njk
page_css: portfolio.css
---

<article class="portfolio">
  <header class="portfolio-header">
    <h1>{{ title | nl2br }}</h1>

    {% if description %}
      <p>
        {{ description | md | safe }}
      </p>
    {% endif %}
  </header>

  {% if sections %}
    {% for section in sections %}
      <section class="portfolio-section">
        <h2>{{ section.heading }}</h2>

        {% if section.body %}
          {{ section.body | md | safe }}
        {% endif %}

        {% if section.links %}
          <ul class="portfolio-links">
            {% for link in section.links %}
              <li>
                <a href="{{ link.href }}">{{ link.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.images %}
          <ul class="portfolio-images">
            {% for image in section.images %}
              <li class="portfolio-image {{ image.orientation }}">
                <figure>
                  <img
                    src="{{ image.src }}"
                    alt="{{ image.alt or '' }}"
                    {% if image.maxWidth %}
                      style="max-width: {{ image.maxWidth }};"
                    {% endif %}
                  />
                  {% if image.label %}
                    <figcaption>{{ image.label }}</figcaption>
                  {% endif %}
                </figure>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endfor %}
  {% endif %}
</article>
