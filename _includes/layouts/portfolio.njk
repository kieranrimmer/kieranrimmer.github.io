---
layout: layouts/base.njk
title: Blogs
main_menu: blogs
---

<main class="blogs">
  <header class="blogs-header">
    <h1>Blogs</h1>
    <p>
      Short, technical notes and write-ups. Mostly systems,
      query engines, and stackql / stackql-ai.
    </p>
  </header>

  {% set posts = [] %}
  {% for p in pages %}
    {% if p.url and p.url.startsWith("/blogs/") and p.url != "/blogs/" %}
      {% set posts = posts.concat([p]) %}
    {% endif %}
  {% endfor %}

  {% if posts.length == 0 %}
    <p class="blogs-empty">
      No posts yet. Add a markdown file anywhere under <code>blogs/</code>.
    </p>
  {% else %}
    <ul class="blogs-list">
      {% for post in posts | sort(attribute="date") | reverse %}
        <li class="blogs-item">
          <a href="{{ post.url }}">{{ post.title }}</a>
          {% if post.date %}
            <time datetime="{{ post.date | date('yyyy-MM-dd') }}">
              {{ post.date | date('d MMM yyyy') }}
            </time>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</main>
