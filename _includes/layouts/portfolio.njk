---
layout: layouts/base.njk
---

<article class="page">
  <header class="page-header">
    <h1>{{ title }}</h1>

    {% if description %}
      <div class="prose">
        {{ description | md | safe }}
      </div>
    {% endif %}
  </header>

  {% if sections %}
    {% for section in sections %}
      <section class="portfolio-section">
        <h2>{{ section.heading }}</h2>

        <div class="portfolio-content">
          {% if section.body %}
            <div class="portfolio-body prose">
              {{ section.body | md | safe }}
            </div>
          {% endif %}

          {% if section.images %}
            <div class="portfolio-images">
              {% for image in section.images %}
                <img
                  src="{{ image.src }}"
                  alt="{{ image.alt or '' }}"
                  style="{% if image.maxWidth %}max-width: {{ image.maxWidth }};{% endif %}"
                />
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% if section.links %}
          <ul class="portfolio-links">
            {% for link in section.links %}
              <li><a href="{{ link.href }}">{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endfor %}
  {% endif %}
</article>
