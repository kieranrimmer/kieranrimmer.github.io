---
layout: ./base.njk
page_css: portfolio.css
---

<main class="portfolio">
  <header class="portfolio-header">
    <h1>{{ title }}</h1>
    {{ description | md | safe }}
  </header>

  {% for section in sections %}
  <section class="portfolio-section">
    <h2>{{ section.heading }}</h2>
    {{ section.body | md | safe }}

    {% if section.links %}
    <ul class="portfolio-links">
      {% for link in section.links %}
      <li>
        <a href="{{ link.href }}" target="_blank">{{ link.label }}</a>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.images and section.images.length %}
    <ul class="portfolio-images">
      {% for img in section.images %}
        <li class="portfolio-image">
          <figure>
            <img
              src="{{ img.src }}"
              alt="{{ img.alt or img.label }}"
              loading="lazy"
              style="{% if img.maxWidth %}max-width: {{ img.maxWidth }};{% endif %}{% if img.maxHeight %}max-height: {{ img.maxHeight }};{% endif %}"
            >
            {% if img.label %}
              <figcaption>{{ img.label }}</figcaption>
            {% endif %}
          </figure>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  </section>
  {% endfor %}
</main>
