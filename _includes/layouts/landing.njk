---
layout: ./base.njk
page_css: landing.css
---

{% if gallery %}
<section class="landing-gallery">
  <header class="landing-gallery-header">
    <h2>{{ gallery.title }}</h2>
  </header>

  <ul class="landing-gallery-items">
    {% for item in gallery.items %}
    <li class="landing-gallery-item{% if item.orientation %} is-{{ item.orientation }}{% endif %}">
      {% if item.href %}<a class="landing-gallery-link" href="{{ item.href }}">{% endif %}
        <figure
          class="landing-gallery-figure"
          {% if item.maxWidth %}
            style="max-width: {{ item.maxWidth }};"
          {% endif %}
        >
          <img src="{{ item.src }}" alt="{{ item.alt or '' }}" loading="lazy">
          {% if item.caption %}
          <figcaption class="landing-gallery-caption">{{ item.caption }}</figcaption>
          {% endif %}
        </figure>
      {% if item.href %}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
