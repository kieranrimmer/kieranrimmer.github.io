---
layout: ./base.njk
page_css: blogs.css
---

<main class="blogs">
  <header class="blogs-header">
    <h1>{{ title }}</h1>
    {% if description %}
      {{ description | md | safe }}
    {% endif %}
  </header>

  {# collect pages safely #}
  {% set ns = namespace(posts=[]) %}
  {% for p in search.pages() %}
    {% if p.url is string %}
      {% if p.url | slice(0, 7) == "/blogs/" and p.url != "/blogs/" %}
        {% set ns.posts = ns.posts.concat([p]) %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if ns.posts.length %}
    <ul class="blogs-list">
      {% for p in ns.posts %}
        <li class="blogs-item">
          <a class="blogs-link" href="{{ p.url }}">
            <span class="blogs-title">{{ p.title }}</span>
            {% if p.date %}
              <time class="blogs-date" datetime="{{ p.date }}">{{ p.date }}</time>
            {% endif %}
          </a>
          {% if p.summary %}
            <p class="blogs-summary">{{ p.summary }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="blogs-empty">No posts yet.</p>
  {% endif %}
</main>
