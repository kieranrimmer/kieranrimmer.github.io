---
layout: ./base.njk
page_css: blogs.css
---

<main class="blogs">
  <header class="blogs-header">
    <h1>{{ title }}</h1>
    {% if description %}
      {{ description | md | safe }}
    {% endif %}
  </header>

  {# Let Lume do the filtering safely #}
  {% set posts = search.pages("url^=/blogs/") | rejectattr("url", "equalto", "/blogs/") %}

  {% if posts.length %}
    <ul class="blogs-list">
      {% for p in posts %}
        <li class="blogs-item">
          <a class="blogs-link" href="{{ p.url }}">
            <span class="blogs-title">{{ p.title }}</span>
            {% if p.date %}
              <time class="blogs-date" datetime="{{ p.date }}">{{ p.date }}</time>
            {% endif %}
          </a>
          {% if p.summary %}
            <p class="blogs-summary">{{ p.summary }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="blogs-empty">No posts yet.</p>
  {% endif %}
</main>
